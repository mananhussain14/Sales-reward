# Peer dependencies are RESOLVED, not ignored.
#
# WHY THIS FILE EXISTS. package-lock.json is only reproducible if every machine that writes
# it resolves peer dependencies the same way CI does. A developer whose ~/.npmrc sets
# `legacy-peer-deps=true` silently skips peer resolution, and `npm install` then writes a
# tree that npm rejects under the default settings — which is exactly how the lockfile came
# to hoist fdir (peer picomatch@^3 || ^4) alongside picomatch@2.3.2 and break `npm ci` in
# GitHub Actions with a picomatch mismatch.
#
# A project-level .npmrc takes precedence over the user-level one, so this pins the
# behaviour for this repository regardless of individual machine configuration. It matches
# the npm default; it is stated explicitly so that a contrary personal setting cannot
# re-introduce an unreproducible lock file.
#
# NO REGISTRY, TOKEN, SCOPE OR CREDENTIAL BELONGS IN THIS FILE. It is committed.
legacy-peer-deps=false
